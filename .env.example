# cutter configuration — copy to .env and fill in.
# Only the sections for the features you actually use are required.
# Tokens marked "(cutter auth ...)" are written automatically by the auth
# commands; you only need to provide the app/client credentials by hand.

# ── Claude (required — caption generation + the assistant) ─────────────────
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model the read-only Telegram assistant uses to answer questions.
ASSISTANT_MODEL=claude-opus-4-8

# ── Telegram (approval conversations, notifications, the assistant) ─────────
# See docs/telegram_setup.md. Create a bot with @BotFather for the token,
# then run `cutter auth telegram` to capture your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── TikTok (see docs/tiktok_oauth.md) ──────────────────────────────────────
# TikTok rejects API access for personal apps, so the default mode is "manual":
# the clip + caption are sent to Telegram to post by hand (no credentials
# needed for manual mode). "inbox"/"direct" need the credentials below.
TIKTOK_POST_MODE=manual
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/callback
# Written by `cutter auth tiktok`:
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=

# ── Instagram Reels (see docs/instagram_oauth.md) ──────────────────────────
# Uses the Instagram API with Instagram login (no Facebook Page). The app
# ID/secret come from the Instagram business-login section of the Meta app.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://cutter.chris.uk.com/instagram/callback
# Written by `cutter auth instagram`:
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ── Facebook Reels (see docs/facebook_oauth.md) ────────────────────────────
# Posts to a Facebook Page. Uses the MAIN Meta app credentials (App Settings →
# Basic), distinct from the Instagram-login ones above. Requires a Page you
# administer; public posting needs App Review + business verification.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CONFIG_ID=          # Facebook Login for Business configuration ID
FACEBOOK_PAGE_NAME=          # optional: pick a specific Page if you manage several
# Written by `cutter auth facebook`:
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# ── YouTube Shorts ─────────────────────────────────────────────────────────
# Google OAuth client (Google Cloud Console → YouTube Data API v3).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Written by `cutter auth youtube`:
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ── Media staging server (Instagram video ingest) ─────────────────────────
# Instagram's API pulls the video from a public URL, so clips are copied to a
# web server during posting and deleted afterwards. Set MEDIA_HOST=local when
# cutter runs on the web server itself (then it's a local file copy, no SSH).
MEDIA_HOST=
MEDIA_USER=root
MEDIA_WEBROOT=
MEDIA_BASE_URL=
MEDIA_SSH_KEY=               # defaults to ~/.ssh/id_ed25519

# ── YouTube downloading ────────────────────────────────────────────────────
# YouTube blocks datacenter/server IPs from video streams. The recommended fix
# is the residential download helper (`cutter fetch`, see docs/fetch_helper.md),
# which needs no cookies. YOUTUBE_COOKIES (a Netscape cookies.txt path) is an
# optional fallback for the machine that actually downloads.
YOUTUBE_COOKIES=

# Download helper (`cutter fetch`, run on a home/residential machine). These
# can also be passed as CLI flags; env vars are optional.
FETCH_SERVER=                # e.g. root@your-server.example.com
# FETCH_REMOTE_CUTTER=HOME=/root /opt/cutter/.venv/bin/cutter
# FETCH_REMOTE_DATADIR=/root/.local/share/cutter
